# Environment Variables Template
# Copy this file to .env and add your actual values

# Anthropic API Key for Claude AI (Server-side only)
# Get your API key from: https://console.anthropic.com/
# Note: API key is only used on the server side for security.
# Client-side code makes requests through the server proxy.
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Set to production for Heroku deployment
# NODE_ENV=production
